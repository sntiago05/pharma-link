# Copy this file to .env and set the local values. Never commit .env.

# --- Database (required: the API fails fast if any is missing) ---
DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=pharmalink

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Authentication ---
# Use a long, unique value in production.
JWT_SECRET=change-me-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# --- CORS ---
# Comma-separated list of allowed origins. Use * only in development.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# --- Logging ---
# error | warn | info | http | debug
LOG_LEVEL=info

# --- Business rules ---
# Timezone used to resolve "today" for past-date checks and dashboards.
APP_TIMEZONE=America/Bogota
# Stock at or below this value is reported as low in the pharmacy dashboard.
LOW_STOCK_THRESHOLD=10
