
# --- Database  ---
DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=pharmalink

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Authentication ---
# Use a long, unique value in production.
JWT_SECRET=Z7h#sM9!vL2@kQ8rX5$pN1wF6yA3tB0uJ4gE9cD7zR2mH8xP5nV1qL6sT3a
JWT_EXPIRES_IN=8h


CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# --- Logging ---
# error | warn | info | http | debug
LOG_LEVEL=info

# --- Business rules ---
# Timezone used to resolve "today" for past-date checks and dashboards.
APP_TIMEZONE=America/Bogota
# Stock at or below this value is reported as low in the pharmacy dashboard.
LOW_STOCK_THRESHOLD=10
